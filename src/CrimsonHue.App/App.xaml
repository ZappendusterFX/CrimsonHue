<Application x:Class="CrimsonHue.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Surface" Color="#171A22" />
    <SolidColorBrush x:Key="Line" Color="#303440" />
    <SolidColorBrush x:Key="Muted" Color="#A7ADBC" />
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#ECEEF3" /></Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#EEF0F5" /><Setter Property="Background" Value="#292E3C" />
      <Setter Property="BorderBrush" Value="#3C4354" /><Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="15,10" /><Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="Opacity" Value="0.82" /></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Border" Property="Opacity" Value="0.38" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#10131B" /><Setter Property="Foreground" Value="#E7EAF1" />
      <Setter Property="CaretBrush" Value="#FFFFFF" /><Setter Property="BorderBrush" Value="#353B4B" />
      <Setter Property="Padding" Value="10,9" /><Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#CDD1DD" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
    <Style TargetType="Slider"><Setter Property="Margin" Value="0,7,0,14" /><Setter Property="IsMoveToPointEnabled" Value="True" /></Style>
    <Style TargetType="Expander"><Setter Property="Foreground" Value="#DDE0E9" /></Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="#252B38" /><Setter Property="Foreground" Value="#ECEEF3" /><Setter Property="BorderBrush" Value="#3C4354" />
      <Setter Property="Padding" Value="10" /><Setter Property="MinHeight" Value="40" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#252B38" BorderBrush="#3C4354" BorderThickness="1" CornerRadius="5"><TextBlock Text="▾" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" /></Border></ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" Margin="10,8,28,8" VerticalAlignment="Center" />
          <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
            <Border Background="#252B38" BorderBrush="#4A5367" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="300"><ScrollViewer><ItemsPresenter /></ScrollViewer></Border>
          </Popup>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#ECEEF3" /><Setter Property="Padding" Value="8" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Item" Padding="{TemplateBinding Padding}" Background="Transparent"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#444C60" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Application.Resources>
</Application>
