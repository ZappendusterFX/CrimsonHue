<Window x:Class="CrimsonHue.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:CrimsonHue.App"
        Title="CrimsonHue — spatial game lighting" Width="1220" Height="890" MinWidth="1020" MinHeight="740" Background="#101219" Foreground="#ECEEF3" FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterScreen" Closing="OnClosing">
  <Grid Margin="26,22">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid Margin="0,0,0,23">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <Border Background="#CE3E5D" Width="42" Height="42" CornerRadius="12" Margin="0,0,13,0"><TextBlock Text="C" FontSize="27" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
        <StackPanel><TextBlock Text="CrimsonHue" FontSize="26" FontWeight="SemiBold" /><TextBlock Text="Bring Pywel into your room" Foreground="{StaticResource Muted}" FontSize="12" /></StackPanel>
      </StackPanel>
      <Border Grid.Column="1" Background="#211923" CornerRadius="6" Padding="11,7" VerticalAlignment="Center"><TextBlock Text="EARLY PREVIEW  /  0.1.3" Foreground="#EF9BAC" FontSize="11" FontWeight="SemiBold" /></Border>
    </Grid>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="330" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,5,0">
        <StackPanel>
          <Border Background="{StaticResource Surface}" CornerRadius="12" Padding="18" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="01  /  CONNECT YOUR BRIDGE" Foreground="#9CA6BE" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,14" />
              <TextBlock Text="Hue or diyHue bridge" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10" />
              <TextBox x:Name="BridgeAddress" Text="192.168.2.109" ToolTip="Local bridge IPv4 address. Connections use HTTPS." AutomationProperties.Name="Bridge address" />
              <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Button x:Name="FindButton" Content="Find bridge" Click="ProbeClick" /><Button Grid.Column="2" Content="Open bridge UI" Click="OpenBridgeClick" />
              </Grid>
              <TextBlock x:Name="BridgeStatus" Text="Find your bridge to start pairing." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,12,0,0" />
              <StackPanel x:Name="PairPanel" Visibility="Collapsed" Margin="0,12,0,0">
                <TextBlock Text="Press the link button on your bridge, or in diyHue's web UI. Then trust this bridge and pair." TextWrapping="Wrap" Foreground="#C2C8D6" />
                <TextBlock x:Name="CertificateLabel" TextWrapping="Wrap" Foreground="#808B9F" FontSize="10" Margin="0,8,0,8" />
                <Button x:Name="PairButton" Content="Trust bridge &amp; pair" Background="#A63450" BorderBrush="#B94965" Click="PairClick" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Background="{StaticResource Surface}" CornerRadius="12" Padding="18" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="02  /  CHOOSE YOUR ROOM" Foreground="#9CA6BE" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,14" />
              <TextBlock Text="Entertainment area" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10" />
              <ComboBox x:Name="AreaBox" SelectionChanged="AreaChanged" AutomationProperties.Name="Entertainment area" />
              <TextBlock Text="Create and position your lights in the Hue app. CrimsonHue reads that layout." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,10,0,10" />
              <Button x:Name="RefreshButton" Content="Refresh areas" Click="RefreshClick" IsEnabled="False" />
              <TextBlock x:Name="LayoutInfo" TextWrapping="Wrap" Foreground="#BDB5CF" Margin="0,10,0,0" />
            </StackPanel>
          </Border>
          <Border Background="{StaticResource Surface}" CornerRadius="12" Padding="18">
            <StackPanel>
              <TextBlock Text="03  /  TUNE THE FEEL" Foreground="#9CA6BE" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,14" />
              <DockPanel><TextBlock Text="Fade starts" /><TextBlock x:Name="FadeStartValue" HorizontalAlignment="Right" /></DockPanel>
              <Slider x:Name="FadeStartSlider" Minimum="0" Maximum="99.5" Value="0" TickFrequency="0.5" SmallChange="0.5" IsSnapToTickEnabled="True" ValueChanged="SettingsChanged" AutomationProperties.Name="Distance fade start" ToolTip="Full distance strength up to this distance from the player." />
              <DockPanel><TextBlock Text="Off beyond" /><TextBlock x:Name="FadeEndValue" HorizontalAlignment="Right" /></DockPanel>
              <Slider x:Name="FadeEndSlider" Minimum="1" Maximum="100" Value="35" TickFrequency="0.5" SmallChange="0.5" IsSnapToTickEnabled="True" ValueChanged="SettingsChanged" AutomationProperties.Name="Distance fade end" ToolTip="No new contribution at or beyond this distance. Smoothing still applies." />
              <TextBlock Text="Distance from player · game units&#x0a;Smooth fade out and back in between both values." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,12" />
              <DockPanel><TextBlock Text="Maximum brightness" /><TextBlock x:Name="BrightnessValue" HorizontalAlignment="Right" /></DockPanel>
              <Slider x:Name="BrightnessSlider" Minimum="0" Maximum="1" Value="0.6" ValueChanged="SettingsChanged" AutomationProperties.Name="Maximum brightness" />
              <DockPanel><TextBlock Text="Light sensitivity" /><TextBlock x:Name="GainValue" HorizontalAlignment="Right" /></DockPanel>
              <Slider x:Name="GainSlider" Minimum="0.05" Maximum="10" Value="1.5" ValueChanged="SettingsChanged" AutomationProperties.Name="Light sensitivity" />
              <Expander Header="Advanced settings">
                <StackPanel Margin="0,12,0,0">
                  <TextBlock Text="Directional focus · broad → narrow" /><Slider x:Name="SpreadSlider" Minimum="0.1" Maximum="8" Value="2" ValueChanged="SettingsChanged" />
                  <TextBlock Text="Smoothing (legacy feed only, milliseconds)" /><Slider x:Name="SmoothingSlider" Minimum="0" Maximum="1000" Value="100" ValueChanged="SettingsChanged" />
                  <TextBlock Text="Telemetry WebSocket" Margin="0,0,0,6" /><TextBox x:Name="TelemetryAddress" Text="ws://127.0.0.1:27311/v1/stream" FontSize="11" />
                  <Button Content="Reconnect telemetry" Margin="0,8,0,0" Click="ReconnectClick" />
                </StackPanel>
              </Expander>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" MinHeight="230" /><RowDefinition Height="160" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Background="{StaticResource Surface}" CornerRadius="10" Padding="16,12" Margin="0,0,0,14">
          <StackPanel><TextBlock x:Name="TelemetryStatus" Text="Waiting for CrimsonDesertTelemetry" FontWeight="SemiBold" /><TextBlock x:Name="CaptureInfo" Text="Start the game with CrimsonDesertTelemetry 2.2.1 installed." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" /></StackPanel>
        </Border>
        <Border Grid.Row="1" Background="#141720" CornerRadius="12" BorderBrush="#2A2E3C" BorderThickness="1">
          <Grid Margin="16">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <DockPanel><TextBlock Text="YOUR ROOM" FontSize="11" FontWeight="SemiBold" Foreground="#9CA6BE" /><CheckBox x:Name="DemoCheck" Content="Demo preview only" HorizontalAlignment="Right" Checked="DemoChanged" Unchecked="DemoChanged" /></DockPanel>
            <local:RoomView x:Name="Room" Grid.Row="1" Margin="0,8" />
            <TextBlock Grid.Row="2" Text="Top view · screen ahead · imported Hue positions" HorizontalAlignment="Center" Foreground="#7E889E" FontSize="11" />
          </Grid>
        </Border>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,12,0,6">
          <ItemsControl x:Name="ChannelCards">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate>
              <Border Background="#1C202B" CornerRadius="7" Width="155" Margin="0,0,8,8" Padding="10" ToolTip="{Binding Details}">
                <StackPanel><DockPanel><Ellipse Width="10" Height="10" Fill="{Binding Color}" Margin="0,0,7,0" /><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="12" /></DockPanel><TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="#8F9AB0" Margin="0,5,0,0" /></StackPanel>
              </Border>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <Border Grid.Row="3" Background="#201923" CornerRadius="12" Padding="17">
          <StackPanel>
            <TextBlock x:Name="StreamStatus" Text="Preview is read-only. Start sync when you're ready." TextWrapping="Wrap" Foreground="#E8C0CB" Margin="0,0,0,12" />
            <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions>
              <Button x:Name="StartButton" Content="Start lighting sync" Background="#BC3556" BorderBrush="#D24A6B" FontWeight="SemiBold" Click="StartClick" IsEnabled="False" />
              <Button x:Name="StopButton" Grid.Column="2" Content="Stop" Click="StopClick" IsEnabled="False" />
            </Grid>
            <TextBlock Text="Stop restores previous light states. Keep other sync apps stopped." TextWrapping="Wrap" Foreground="#9B8895" FontSize="11" Margin="0,10,0,0" />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
    <TextBlock Grid.Row="2" Margin="0,17,0,0" Text="Source-driven lighting estimate · no screen capture · independent companion for CrimsonDesertTelemetry" Foreground="#737D91" FontSize="11" />
  </Grid>
</Window>
