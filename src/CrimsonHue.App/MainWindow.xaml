<Window x:Class="CrimsonHue.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:CrimsonHue.App"
 Title="CrimsonHue — spatial game lighting" Width="1440" Height="960" MinWidth="1120" MinHeight="780" Background="#101219" Foreground="#ECEEF3" FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterScreen" Closing="OnClosing">
 <Grid Margin="24,20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,18">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal">
    <Border Background="#CE3E5D" Width="42" Height="42" CornerRadius="12" Margin="0,0,13,0"><TextBlock Text="C" FontSize="27" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <StackPanel><TextBlock Text="CrimsonHue" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Live lighting mixer · see the input, shape the output" Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel>
   </StackPanel>
   <Border Grid.Column="1" Background="#211923" CornerRadius="6" Padding="11,7" VerticalAlignment="Center"><TextBlock Text="EARLY PREVIEW  /  0.3.1" Foreground="#EF9BAC" FontSize="11" FontWeight="SemiBold"/></Border>
  </Grid>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="420"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="{StaticResource Surface}" CornerRadius="12" Padding="14">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Margin="2,0,2,12"><TextBlock Text="LIVE MIXER" Foreground="#E9A1B0" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="Sliders and numeric entries update preview and sync." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
     <TabControl x:Name="MixerTabs" Grid.Row="1">
      <TabItem Header="Output" Tag="Output"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="OutputControls" Margin="10,3,10,10"/></ScrollViewer></TabItem>
      <TabItem Header="Ambient" Tag="Ambient"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="AmbientControls" Margin="10,3,10,10"/></ScrollViewer></TabItem>
      <TabItem Header="Color" Tag="Color"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ColorControls" Margin="10,3,10,10"/></ScrollViewer></TabItem>
      <TabItem Header="Space" Tag="Space"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="SpatialControls" Margin="10,3,10,10"/></ScrollViewer></TabItem>
      <TabItem Header="Setup" Tag="Setup">
       <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
        <TextBlock Text="BRIDGE &amp; ENTERTAINMENT AREA" Foreground="#9CA6BE" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <TextBlock Text="Hue or diyHue bridge" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBox x:Name="BridgeAddress" Text="192.168.2.109" ToolTip="Local bridge IPv4 address. Connections use HTTPS." AutomationProperties.Name="Bridge address"/>
        <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="FindButton" Content="Find bridge" Click="ProbeClick"/><Button Grid.Column="2" Content="Open bridge UI" Click="OpenBridgeClick"/></Grid>
        <TextBlock x:Name="BridgeStatus" Text="Find your bridge to start pairing." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/>
        <StackPanel x:Name="PairPanel" Visibility="Collapsed" Margin="0,12,0,0">
         <TextBlock Text="Press the bridge link button, or its diyHue web UI equivalent, then pair within 30 seconds." TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
         <TextBlock x:Name="CertificateLabel" TextWrapping="Wrap" FontFamily="Consolas" FontSize="10" Foreground="#8C95AB" Margin="0,8,0,8"/>
         <Button x:Name="PairButton" Content="Trust bridge &amp; pair" Click="PairClick"/>
        </StackPanel>
        <TextBlock Text="Entertainment area" FontSize="16" FontWeight="SemiBold" Margin="0,24,0,8"/>
        <ComboBox x:Name="AreaBox" SelectionChanged="AreaChanged" AutomationProperties.Name="Entertainment area"/>
        <TextBlock Text="Create and position lamps in the Hue app. Imported channel positions are preserved." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,8,0,10"/>
        <Button x:Name="RefreshButton" Content="Refresh areas" Click="RefreshClick" IsEnabled="False"/>
        <TextBlock x:Name="LayoutInfo" TextWrapping="Wrap" Foreground="#BDB5CF" Margin="0,10,0,0"/>
        <TextBlock Text="Telemetry WebSocket" FontWeight="SemiBold" Margin="0,24,0,8"/>
        <TextBox x:Name="TelemetryAddress" Text="ws://127.0.0.1:27311/v1/stream" FontSize="11"/>
        <Button Content="Reconnect telemetry" Margin="0,8,0,0" Click="ReconnectClick"/>
       </StackPanel></ScrollViewer>
      </TabItem>
     </TabControl>
     <StackPanel Grid.Row="2" Margin="2,12,2,0">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="Reset this tab" Click="ResetTabClick"/><Button Grid.Column="2" Content="Save settings" Click="SaveTuningClick"/></Grid>
      <TextBlock x:Name="TuningStatus" Text="All values visible · ↺ resets one control" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0"/>
     </StackPanel>
    </Grid>
   </Border>
   <Grid Grid.Column="2">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="{StaticResource Surface}" CornerRadius="10" Padding="16,12" Margin="0,0,0,12">
     <StackPanel><TextBlock x:Name="TelemetryStatus" Text="Waiting for CrimsonDesertTelemetry" FontWeight="SemiBold"/><TextBlock x:Name="CaptureInfo" Text="Requires the CDT light and Ambient streams." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/><TextBlock x:Name="AmbientStatus" Text="Waiting for CDT Ambient" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/></StackPanel>
    </Border>
    <TabControl x:Name="MonitorTabs" Grid.Row="1" Margin="0,0,0,12">
     <TabItem Header="Room &amp; output">
      <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="*" MinHeight="220"/><RowDefinition Height="155"/></Grid.RowDefinitions>
       <Border Background="#141720" CornerRadius="10" BorderBrush="#2A2E3C" BorderThickness="1">
        <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <DockPanel><TextBlock Text="MAPPED LAMP OUTPUT" FontSize="11" FontWeight="SemiBold" Foreground="#9CA6BE"/><CheckBox x:Name="DemoCheck" Content="Demo preview only" HorizontalAlignment="Right" Checked="DemoChanged" Unchecked="DemoChanged"/></DockPanel>
         <local:RoomView x:Name="Room" Grid.Row="1" Margin="0,8"/>
         <StackPanel Grid.Row="2" HorizontalAlignment="Center"><TextBlock Text="Top view · screen ahead · imported Hue positions" HorizontalAlignment="Center" Foreground="#7E889E" FontSize="11"/><TextBlock x:Name="SpatialBoundaryStatus" HorizontalAlignment="Center" Foreground="#A6C9CF" FontSize="11" Margin="0,4,0,0"/></StackPanel>
        </Grid>
       </Border>
       <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
        <ItemsControl x:Name="ChannelCards"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
         <ItemsControl.ItemTemplate><DataTemplate><Border Background="#1C202B" CornerRadius="7" Width="220" Margin="0,0,8,8" Padding="10" ToolTip="{Binding Details}">
          <StackPanel><DockPanel><Ellipse Width="10" Height="10" Fill="{Binding Color}" Margin="0,0,7,0"/><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="12"/></DockPanel><TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="#8F9AB0" Margin="0,5,0,0"/><TextBlock Text="{Binding Output}" FontFamily="Consolas" FontSize="11" Margin="0,4,0,0"/></StackPanel>
         </Border></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
       </ScrollViewer>
      </Grid>
     </TabItem>
     <TabItem Header="CDT raw input">
      <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <StackPanel><DockPanel><TextBlock Text="UNCHANGED CDT VALUES" Foreground="#75D0C1" FontSize="11" FontWeight="SemiBold"/><CheckBox x:Name="FreezeRawCheck" Content="Freeze readout" HorizontalAlignment="Right" ToolTip="Freeze this displayed sample for reading and copying. Lighting output remains live."/></DockPanel><TextBlock Text="Mixer controls never alter these numbers. Working RGB uses relative engine units, not lamp RGB." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,12"/></StackPanel>
       <Border Grid.Row="1" Background="#11161E" CornerRadius="8" Padding="12"><TextBox x:Name="RawAmbientValues" IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="0" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Text="No fresh Ambient sample"/></Border>
       <StackPanel Grid.Row="2" Margin="0,17,0,8"><TextBlock Text="LOCAL SOURCE VALUES" FontSize="11" FontWeight="SemiBold"/><TextBlock x:Name="RawSourceSummary" Text="Waiting for a fresh light capture" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0"/></StackPanel>
       <DataGrid x:Name="RawLightsGrid" Grid.Row="3" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" SelectionUnit="Cell" ClipboardCopyMode="IncludeHeader" EnableRowVirtualization="True">
        <DataGrid.Columns><DataGridTextColumn Header="Distance" Binding="{Binding Distance}" Width="80" MinWidth="80"/><DataGridTextColumn Header="Raw R" Binding="{Binding Red}" Width="110" MinWidth="110"/><DataGridTextColumn Header="Raw G" Binding="{Binding Green}" Width="110" MinWidth="110"/><DataGridTextColumn Header="Raw B" Binding="{Binding Blue}" Width="110" MinWidth="110"/><DataGridTextColumn Header="World XYZ" Binding="{Binding Position}" Width="*" MinWidth="170"/></DataGrid.Columns>
       </DataGrid>
      </Grid>
     </TabItem>
    </TabControl>
    <Border Grid.Row="2" Background="#201923" CornerRadius="12" Padding="16">
     <StackPanel><TextBlock x:Name="StreamStatus" Text="Preview is read-only. Start sync when you're ready." TextWrapping="Wrap" Foreground="#E8C0CB" Margin="0,0,0,10"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><Button x:Name="StartButton" Content="Start lighting sync" Background="#BC3556" BorderBrush="#D24A6B" FontWeight="SemiBold" Click="StartClick" IsEnabled="False"/><Button x:Name="StopButton" Grid.Column="2" Content="Stop" Click="StopClick" IsEnabled="False"/></Grid>
      <TextBlock Text="Stop restores previous light states. Keep other sync apps stopped." TextWrapping="Wrap" Foreground="#9B8895" FontSize="11" Margin="0,8,0,0"/>
     </StackPanel>
    </Border>
   </Grid>
  </Grid>
  <TextBlock Grid.Row="2" Margin="0,13,0,0" Text="Raw CDT input → adjustable mapping → lamp output · no screen capture · no automatic color correction" Foreground="#737D91" FontSize="11"/>
 </Grid>
</Window>
